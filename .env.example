# Copy this file to .env and change the values before deploying.
#
#   cp .env.example .env
#
# .env is gitignored. Do not commit real passwords.

# Used by both the db service and the app's connection string, so they cannot
# drift apart.
POSTGRES_PASSWORD=change-me

# The first clinical pathologist. The app refuses to start without one, and this
# account is forced to choose a new password at first sign-in.
# Must be at least 6 characters with an uppercase letter, a lowercase letter, a
# digit and a symbol.
SEED_PATHOLOGIST_EMAIL=pathologist@hospital.example
SEED_PATHOLOGIST_PASSWORD=Change-Me-1!
