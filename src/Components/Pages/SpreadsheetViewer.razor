@page "/spreadsheet-viewer"
@page "/spreadsheet"
@using Microsoft.AspNetCore.Authorization
@using penicillisolver_v2.Domain.Constants
@using penicillisolver_v2.Domain.Entities
@using penicillisolver_v2.Domain.ValueObjects
@using penicillisolver_v2.Services
@attribute [Authorize(Policy = AuthorizationPolicyNames.CanReadSpreadsheet)]
@rendermode InteractiveServer

@inject SpreadsheetQueryService QueryService

@* /spreadsheet remains a valid route as well as /spreadsheet-viewer, because
   an existing integration test and any bookmark to the older path must keep
   reaching the spreadsheet page. *@

<PageTitle>@Localizer["Ranking_Title"]</PageTitle>

<h1>@Localizer["Ranking_Heading"]</h1>

@if (isLoading)
{
    <p><em>@Localizer["Ranking_Loading"]</em></p>
}
else if (currentUpload is null)
{
    <p>
        @Localizer["Ranking_NoSpreadsheet"]
    </p>
}
else
{
    <section class="mb-4">
        <dl class="row">
            <dt class="col-sm-3">@Localizer["Ranking_FieldFileName"]</dt>
            <dd class="col-sm-9">@currentUpload.OriginalFileName</dd>

            <dt class="col-sm-3">@Localizer["Ranking_FieldUploaded"]</dt>
            <dd class="col-sm-9">@currentUpload.UploadedAtUtc.ToLocalTime().ToString("f")</dd>

            <dt class="col-sm-3">@Localizer["Ranking_FieldOrganisms"]</dt>
            <dd class="col-sm-9">@currentUpload.OrganismCount</dd>

            <dt class="col-sm-3">@Localizer["Ranking_FieldAntibiotics"]</dt>
            <dd class="col-sm-9">@currentUpload.AntibioticCount</dd>
        </dl>
    </section>

    <section class="mb-4">
        <label class="form-label" for="organism-name">
            @Localizer["Ranking_OrganismLabel"]
        </label>
        <p class="form-text">
            @Localizer["Ranking_OrganismHelp"]
        </p>

        <div class="organism-picker" style="max-width: 32rem;">
            <div class="input-group">
                <input id="organism-name"
                       type="text"
                       class="form-control"
                       autocomplete="off"
                       role="combobox"
                       aria-expanded="@PickerIsOpen"
                       aria-controls="organism-options"
                       aria-autocomplete="list"
                       placeholder="@Localizer["Ranking_OrganismPlaceholder"]"
                       value="@typedOrganismName"
                       @oninput="OnTypedOrganismChanged"
                       @onfocus="OnPickerFocused"
                       @onkeydown="OnPickerKeyDown" />
                <button type="button"
                        class="btn btn-outline-secondary"
                        title="@Localizer["Ranking_ShowWholeList"]"
                        @onclick="OnTogglePickerAsync">
                    ▾
                </button>
                <button type="button"
                        class="btn btn-primary"
                        @onclick="OnShowRankingClickedAsync">
                    @Localizer["Ranking_ShowRanking"]
                </button>
            </div>

            @if (PickerIsOpen && suggestions.Count > 0)
            {
                <ul id="organism-options"
                    class="organism-picker__list list-group"
                    role="listbox">
                    @foreach (string organismName in suggestions)
                    {
                        <li role="none">
                            <button type="button"
                                    role="option"
                                    aria-selected="@IsHighlightedSuggestion(organismName)"
                                    class="organism-picker__option list-group-item list-group-item-action @HighlightClass(organismName)"
                                    @onmousedown:preventDefault
                                    @onclick="() => OnSuggestionChosenAsync(organismName)">
                                @organismName
                            </button>
                        </li>
                    }
                </ul>
            }
            else if (PickerIsOpen)
            {
                <ul id="organism-options" class="organism-picker__list list-group" role="listbox">
                    <li class="list-group-item text-muted">
                        @Localizer["Ranking_NoOrganismMatch", typedOrganismName!]
                    </li>
                </ul>
            }
        </div>

        <div class="form-text">
            @Localizer["Ranking_OrganismCount", suggestions.Count, organismNames.Count]
        </div>

        @if (lookupMessage is not null)
        {
            <div class="alert alert-warning mt-3" role="alert">
                @lookupMessage
            </div>
        }

        @if (ambiguousCandidates.Count > 0)
        {
            <p>@Localizer["Ranking_SeveralMatch"]</p>
            <ul>
                @foreach (string candidate in ambiguousCandidates)
                {
                    <li>
                        <button type="button"
                                class="btn btn-link p-0"
                                @onclick="() => OnCandidateChosenAsync(candidate)">
                            @candidate
                        </button>
                    </li>
                }
            </ul>
        }
    </section>

    @if (hasResolvedOrganism)
    {
        <section class="mb-4">
            <label class="form-label" for="top-count">
                @Localizer["Ranking_TopCountLabel"]
            </label>
            <input id="top-count"
                   type="number"
                   class="form-control"
                   style="max-width: 12rem;"
                   min="1"
                   max="@maximumTopCount"
                   value="@topCount"
                   @onchange="OnTopCountChangedAsync" />
            <div class="form-text">
                @Localizer["Ranking_TopCountHelp", maximumTopCount]
            </div>
            @if (topCountError is not null)
            {
                <div class="text-danger" role="alert">@topCountError</div>
            }
        </section>

        <section class="mb-4">
            <h2>
                @Localizer["Ranking_TopHeading", effectiveTopCount, resolvedOrganismName!]
            </h2>
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">@Localizer["Ranking_RankColumn"]</th>
                        <th scope="col">@Localizer["Ranking_AntibioticColumn"]</th>
                        <th scope="col">@Localizer["Ranking_SusceptibleColumn"]</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int index = 0; index < topSusceptible.Count; index++)
                    {
                        int rank = index + 1;
                        AntibioticSusceptibility row = topSusceptible[index];
                        <tr>
                            <td>@rank</td>
                            <td>
                                @* Requirement 8: show what the abbreviation means
                                   beside it, so an unmapped "CRO %S" is visibly
                                   unmapped rather than silently cryptic. *@
                                <AntibioticNameDisplay
                                    SpreadsheetUploadId="currentUpload.Id"
                                    Abbreviation="@row.AntibioticName" />
                            </td>
                            <td>@row.Value.Format()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}
