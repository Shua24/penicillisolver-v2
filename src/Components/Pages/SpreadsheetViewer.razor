@page "/spreadsheet-viewer"
@page "/spreadsheet"
@using Microsoft.AspNetCore.Authorization
@using penicillisolver_v2.Domain.Constants
@using penicillisolver_v2.Domain.Entities
@using penicillisolver_v2.Domain.ValueObjects
@using penicillisolver_v2.Services
@attribute [Authorize(Policy = AuthorizationPolicyNames.CanReadSpreadsheet)]
@rendermode InteractiveServer

@inject SpreadsheetQueryService QueryService

@* /spreadsheet remains a valid route as well as /spreadsheet-viewer, because
   an existing integration test and any bookmark to the older path must keep
   reaching the spreadsheet page. *@

<PageTitle>Resistance ranking</PageTitle>

<h1>Resistance ranking</h1>

@if (isLoading)
{
    <p><em>Loading the current spreadsheet…</em></p>
}
else if (currentUpload is null)
{
    <p>
        No spreadsheet has been uploaded yet. A clinical pathologist can upload
        one from the <a href="upload">upload page</a>.
    </p>
}
else
{
    <section class="mb-4">
        <dl class="row">
            <dt class="col-sm-3">File name</dt>
            <dd class="col-sm-9">@currentUpload.OriginalFileName</dd>

            <dt class="col-sm-3">Uploaded</dt>
            <dd class="col-sm-9">@currentUpload.UploadedAtUtc.ToLocalTime().ToString("f")</dd>

            <dt class="col-sm-3">Organisms</dt>
            <dd class="col-sm-9">@currentUpload.OrganismCount</dd>

            <dt class="col-sm-3">Antibiotics</dt>
            <dd class="col-sm-9">@currentUpload.AntibioticCount</dd>
        </dl>
    </section>

    <section class="mb-4">
        <label class="form-label" for="organism-name">
            Which organism are you treating?
        </label>
        <p class="form-text">
            The ranking is per organism: it lists what that one species is least
            susceptible to, most resistant first. Drugs this report never tested
            against the organism carry no percentage and are listed after the
            measured ones. Type any part of the name — "aureus" finds every
            Staphylococcus aureus — then choose it from the list.
        </p>

        <div class="organism-picker" style="max-width: 32rem;">
            <div class="input-group">
                <input id="organism-name"
                       type="text"
                       class="form-control"
                       autocomplete="off"
                       role="combobox"
                       aria-expanded="@PickerIsOpen"
                       aria-controls="organism-options"
                       aria-autocomplete="list"
                       placeholder="Start typing an organism name"
                       value="@typedOrganismName"
                       @oninput="OnTypedOrganismChanged"
                       @onfocus="OnPickerFocused"
                       @onkeydown="OnPickerKeyDown" />
                <button type="button"
                        class="btn btn-outline-secondary"
                        title="Show the whole list"
                        @onclick="OnTogglePickerAsync">
                    ▾
                </button>
                <button type="button"
                        class="btn btn-primary"
                        @onclick="OnShowRankingClickedAsync">
                    Show ranking
                </button>
            </div>

            @if (PickerIsOpen && suggestions.Count > 0)
            {
                <ul id="organism-options"
                    class="organism-picker__list list-group"
                    role="listbox">
                    @foreach (string organismName in suggestions)
                    {
                        <li role="none">
                            <button type="button"
                                    role="option"
                                    aria-selected="@IsHighlightedSuggestion(organismName)"
                                    class="organism-picker__option list-group-item list-group-item-action @HighlightClass(organismName)"
                                    @onmousedown:preventDefault
                                    @onclick="() => OnSuggestionChosenAsync(organismName)">
                                @organismName
                            </button>
                        </li>
                    }
                </ul>
            }
            else if (PickerIsOpen)
            {
                <ul id="organism-options" class="organism-picker__list list-group" role="listbox">
                    <li class="list-group-item text-muted">
                        No organism in this file matches "@typedOrganismName".
                    </li>
                </ul>
            }
        </div>

        <div class="form-text">
            @suggestions.Count of @organismNames.Count organisms available.
        </div>

        @if (lookupMessage is not null)
        {
            <div class="alert alert-warning mt-3" role="alert">
                @lookupMessage
            </div>
        }

        @if (ambiguousCandidates.Count > 0)
        {
            <p>Several organisms match. Choose the one you meant:</p>
            <ul>
                @foreach (string candidate in ambiguousCandidates)
                {
                    <li>
                        <button type="button"
                                class="btn btn-link p-0"
                                @onclick="() => OnCandidateChosenAsync(candidate)">
                            @candidate
                        </button>
                    </li>
                }
            </ul>
        }
    </section>

    @if (hasResolvedOrganism)
    {
        <section class="mb-4">
            <label class="form-label" for="top-count">
                How many of the most resistant antibiotics to show
            </label>
            <input id="top-count"
                   type="number"
                   class="form-control"
                   style="max-width: 12rem;"
                   min="1"
                   max="@maximumTopCount"
                   value="@topCount"
                   @onchange="OnTopCountChangedAsync" />
            <div class="form-text">
                Between 1 and @maximumTopCount. Defaults to 3.
            </div>
            @if (topCountError is not null)
            {
                <div class="text-danger" role="alert">@topCountError</div>
            }
        </section>

        <section class="mb-4">
            <h2>
                Top @effectiveTopCount most resistant for
                <em>@resolvedOrganismName</em>
            </h2>
            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">Rank</th>
                        <th scope="col">Antibiotic</th>
                        <th scope="col">% susceptible</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int index = 0; index < topResistant.Count; index++)
                    {
                        int rank = index + 1;
                        AntibioticResistance row = topResistant[index];
                        <tr>
                            <td>@rank</td>
                            <td>
                                @* Requirement 8: show what the abbreviation means
                                   beside it, so an unmapped "CRO %S" is visibly
                                   unmapped rather than silently cryptic. *@
                                <AntibioticNameDisplay
                                    SpreadsheetUploadId="currentUpload.Id"
                                    Abbreviation="@row.AntibioticName" />
                            </td>
                            <td>@row.Value.Format()</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    }
}

