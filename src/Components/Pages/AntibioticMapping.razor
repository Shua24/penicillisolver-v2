@page "/antibiotic-mappings"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using penicillisolver_v2.Domain.Constants
@using penicillisolver_v2.Domain.Entities
@using penicillisolver_v2.Domain.ValueObjects
@using penicillisolver_v2.Services
@attribute [Authorize(Policy = AuthorizationPolicyNames.CanReadSpreadsheet)]
@rendermode InteractiveServer
@inject AntibioticAbbreviationService AbbreviationService
@inject SpreadsheetQueryService QueryService
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<script type="module" src="@Assets["Components/Pages/AntibioticMapping.razor.js"]"></script>

<PageTitle>Antibiotic abbreviations</PageTitle>

<h1>Antibiotic abbreviations</h1>

<p>
    Each antibiotic abbreviation this file uses is listed below, in the order
    the file lists it. Fill in the meaning next to the names that need one and
    save them all at once. Nothing is pre-decided: the meanings are recorded
    by the pathologists, and they belong to this file alone. The same
    abbreviation can mean a different drug in a different file.
</p>

<p>
    A file that already spells its antibiotics out in full needs no mapping at
    all, and this page will say so rather than asking for work that is not
    required.
</p>

@if (isLoading)
{
    <p><em>Loading the current spreadsheet &hellip;</em></p>
}
else if (currentDocument is null)
{
    <div class="alert alert-warning" role="alert">
        <strong>No spreadsheet has been uploaded yet.</strong>
        Mappings attach to an uploaded file, so there is nothing to map until one
        exists. Upload a spreadsheet first, then return to this page.
    </div>
}
else
{
    @if (statusMessage is not null)
    {
        <div class="alert @(statusSucceeded ? "alert-success" : "alert-danger")" role="alert">
            @statusMessage
        </div>
    }

    <p>
        Current file: <strong>@currentUpload!.OriginalFileName</strong>
        &mdash; @mappingRows.Count detected abbreviation
        @(mappingRows.Count == 1 ? "" : "s"),
        with @mappedRowCount mapped.
    </p>

    @if (mappingIsNotApplicable)
    {
        <div class="alert alert-info" role="alert">
            <strong>No mapping is needed for this file.</strong>
            Every antibiotic in it is already listed under its full name, so
            there is no abbreviation for a pathologist to interpret. This page
            only has work to do when a file names its antibiotics in short form,
            such as <code>AMK %S</code>.
        </div>
    }
    else
    {
        <section aria-label="Abbreviation worksheet">
            <h2>Abbreviation worksheet</h2>

            @if (canManageMappings)
            {
                <p class="text-muted">
                    Fill in any empty box with the full drug name, then press
                    <em>Save mappings</em>. A meaning you want to remove is
                    removed with its <em>Remove</em> button, not by clearing the
                    box.
                </p>
            }
            else
            {
                <p class="text-muted">
                    You can view the mappings, but only a clinical pathologist may
                    add, edit, or remove them.
                </p>
            }

            @if (mappingRows.Count == 0)
            {
                <p><em>This file lists no abbreviations that need a meaning.</em></p>
            }
            else
            {
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col" class="col-auto">Abbreviation</th>
                            <th scope="col">Full name</th>
                            <th scope="col">Last modified</th>
                            @if (canManageMappings)
                            {
                                <th scope="col" class="col-auto">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (AntibioticMappingRow row in mappingRows)
                        {
                            <tr>
                                <td><code>@row.Abbreviation</code></td>
                                <td>
                                    @if (canManageMappings)
                                    {
                                        <InputText class="form-control"
                                                   placeholder="Full drug name"
                                                   @bind-Value="row.WorkingFullName" />
                                    }
                                    else
                                    {
                                        @if (string.IsNullOrEmpty(row.StoredFullName))
                                        {
                                            <em>unmapped</em>
                                        }
                                        else
                                        {
                                            @row.StoredFullName
                                        }
                                    }
                                </td>
                                <td>
                                    @(row.Mapping is null
                                        ? "—"
                                        : row.Mapping.LastModifiedAtUtc.ToLocalTime().ToString("g"))
                                </td>
                                @if (canManageMappings)
                                {
                                    <td>
                                        @if (row.Mapping is not null)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => RequestDelete(row)">
                                                Remove
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>

                @if (canManageMappings)
                {
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveMappingsAsync">
                        Save mappings
                    </button>
                }
            }
        </section>
    }
}

<dialog id="antibiotic-mapping-delete-dialog"
        class="antibiotic-mapping-delete-dialog"
        aria-labelledby="antibiotic-mapping-delete-title">
    <div class="antibiotic-mapping-delete-card">
        <h3 id="antibiotic-mapping-delete-title">Remove mapping</h3>
        <p>
            Remove the meaning of <code>@pendingDelete?.Abbreviation</code>
            @if (pendingDelete is not null
                && !string.IsNullOrEmpty(pendingDelete.StoredFullName))
            {
                <text>&nbsp;(currently <em>@pendingDelete.StoredFullName</em>)</text>
            }
            &mdash; the abbreviation will show as unmapped.
        </p>
        <div class="antibiotic-mapping-delete-actions">
            <button id="antibiotic-mapping-delete-confirm"
                    type="button" class="btn btn-danger" @onclick="() => ConfirmDeleteAsync()">
                Yes, remove it
            </button>
            <button id="antibiotic-mapping-delete-cancel"
                    type="button" class="btn btn-secondary" @onclick="() => CancelDelete()">
                Cancel
            </button>
        </div>
    </div>
</dialog>
