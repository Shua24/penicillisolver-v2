@page "/antibiotic-mappings"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using penicillisolver_v2.Domain.Constants
@using penicillisolver_v2.Domain.Entities
@using penicillisolver_v2.Domain.ValueObjects
@using penicillisolver_v2.Services
@attribute [Authorize(Policy = AuthorizationPolicyNames.CanReadSpreadsheet)]
@rendermode InteractiveServer
@inject AntibioticAbbreviationService AbbreviationService
@inject SpreadsheetQueryService QueryService
@inject IAuthorizationService AuthorizationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<script type="module" src="@Assets["Components/Pages/AntibioticMapping.razor.js"]"></script>

<PageTitle>@Localizer["Mappings_Title"]</PageTitle>

<h1>@Localizer["Mappings_Heading"]</h1>

<p>
    @Localizer["Mappings_IntroFirst"]
</p>

<p>
    @Localizer["Mappings_IntroSecond"]
</p>

@if (isLoading)
{
    <p><em>@Localizer["Mappings_Loading"]</em></p>
}
else if (currentDocument is null)
{
    <div class="alert alert-warning" role="alert">
        <strong>@Localizer["Mappings_NoSpreadsheetHeading"]</strong>
        @Localizer["Mappings_NoSpreadsheetBody"]
    </div>
}
else
{
    @if (statusMessage is not null)
    {
        <div class="alert @(statusSucceeded ? "alert-success" : "alert-danger")" role="alert">
            @statusMessage
        </div>
    }

    <p>
        @Localizer["Mappings_CurrentFile"] <strong>@currentUpload!.OriginalFileName</strong>
        &mdash; @Localizer["Mappings_DetectedAbbreviations", mappingRows.Count, mappedRowCount]
    </p>

    @if (mappingIsNotApplicable)
    {
        <div class="alert alert-info" role="alert">
            <strong>@Localizer["Mappings_NotApplicableHeading"]</strong>
            @Localizer["Mappings_NotApplicableBody"]
        </div>
    }
    else
    {
        <section aria-label="@Localizer["Mappings_WorksheetAriaLabel"]">
            <h2>@Localizer["Mappings_WorksheetHeading"]</h2>

            @if (canManageMappings)
            {
                <p class="text-muted">
                    @Localizer["Mappings_EditorHelp"]
                </p>
            }
            else
            {
                <p class="text-muted">
                    @Localizer["Mappings_ReaderHelp"]
                </p>
            }

            @if (mappingRows.Count == 0)
            {
                <p><em>@Localizer["Mappings_NoAbbreviations"]</em></p>
            }
            else
            {
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th scope="col" class="col-auto">@Localizer["Mappings_ColumnAbbreviation"]</th>
                            <th scope="col">@Localizer["Mappings_ColumnFullName"]</th>
                            <th scope="col">@Localizer["Mappings_ColumnLastModified"]</th>
                            @if (canManageMappings)
                            {
                                <th scope="col" class="col-auto">@Localizer["Mappings_ColumnActions"]</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (AntibioticMappingRow row in mappingRows)
                        {
                            <tr>
                                <td><code>@row.Abbreviation</code></td>
                                <td>
                                    @if (canManageMappings)
                                    {
                                        <InputText class="form-control"
                                                   placeholder="@Localizer["Mappings_FullDrugNamePlaceholder"]"
                                                   @bind-Value="row.WorkingFullName" />
                                    }
                                    else
                                    {
                                        @if (string.IsNullOrEmpty(row.StoredFullName))
                                        {
                                            <em>@Localizer["AntibioticName_Unmapped"]</em>
                                        }
                                        else
                                        {
                                            @row.StoredFullName
                                        }
                                    }
                                </td>
                                <td>
                                    @(row.Mapping is null
                                        ? "—"
                                        : row.Mapping.LastModifiedAtUtc.ToLocalTime().ToString("g"))
                                </td>
                                @if (canManageMappings)
                                {
                                    <td>
                                        @if (row.Mapping is not null)
                                        {
                                            <button type="button"
                                                    class="btn btn-sm btn-outline-danger"
                                                    @onclick="() => RequestDelete(row)">
                                                @Localizer["Mappings_Remove"]
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>

                @if (canManageMappings)
                {
                    <button type="button"
                            class="btn btn-primary"
                            @onclick="SaveMappingsAsync">
                        @Localizer["Mappings_Save"]
                    </button>
                }
            }
        </section>
    }
}

<dialog id="antibiotic-mapping-delete-dialog"
        class="antibiotic-mapping-delete-dialog"
        aria-labelledby="antibiotic-mapping-delete-title">
    <div class="antibiotic-mapping-delete-card">
        <h3 id="antibiotic-mapping-delete-title">@Localizer["Mappings_RemoveDialogTitle"]</h3>
        <p>
            @if (pendingDelete is not null
                && !string.IsNullOrEmpty(pendingDelete.StoredFullName))
            {
                @Localizer["Mappings_RemoveDialogBodyCurrent", pendingDelete.Abbreviation, pendingDelete.StoredFullName]
            }
            else
            {
                @Localizer["Mappings_RemoveDialogBody", pendingDelete?.Abbreviation ?? string.Empty]
            }
        </p>
        <div class="antibiotic-mapping-delete-actions">
            <button id="antibiotic-mapping-delete-confirm"
                    type="button" class="btn btn-danger" @onclick="() => ConfirmDeleteAsync()">
                @Localizer["Mappings_RemoveDialogConfirm"]
            </button>
            <button id="antibiotic-mapping-delete-cancel"
                    type="button" class="btn btn-secondary" @onclick="() => CancelDelete()">
                @Localizer["Mappings_RemoveDialogCancel"]
            </button>
        </div>
    </div>
</dialog>
