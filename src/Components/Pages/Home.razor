@page "/"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using penicillisolver_v2.Domain.Constants
@using penicillisolver_v2.Domain.Entities

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>PenicilliSolver</PageTitle>

<h1>PenicilliSolver</h1>

<p>
    @Localizer["Home_Intro"]
</p>

<AuthorizeView Context="signedInState">
    <NotAuthorized>
        <section class="mb-4">
            <h2>@Localizer["Home_SignInHeading"]</h2>
            <p>
                @Localizer["Home_SignInBody"]
            </p>
            <p>
                <a class="btn btn-primary" href="Account/Login">@Localizer["Nav_LogIn"]</a>
                <a class="btn btn-secondary" href="Account/Register">@Localizer["Nav_Register"]</a>
            </p>
        </section>
    </NotAuthorized>

    <Authorized>
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <span class="text-body-secondary">@Localizer["Home_SignedInAs"]</span>
                <strong>@signedInAs</strong>
            </div>
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-secondary">@Localizer["Home_SignedInBadge"]</span>
                <a class="btn btn-link btn-sm text-body-secondary p-0" href="Account/Delete">
                    @Localizer["Home_DeleteMyAccount"]
                </a>
            </div>
        </div>

        @* A pending account can sign in but holds no permissions, so it reaches
           no other page. Say so here rather than leaving a signed-in user on a
           blank home screen wondering why every link is missing. *@
        <AuthorizeView Policy="@AuthorizationPolicyNames.CanReadSpreadsheet" Context="readState">
            <Authorized>
                <!-- Clinical Tools -->
                <section class="mb-4">
                    <h2 class="h4 mb-3">@Localizer["Home_ClinicalToolsHeading"]</h2>
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        <div class="col">
                            <div class="card h-100">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@Localizer["Home_SusceptibilityRankingTitle"]</h5>
                                    <p class="card-text text-body-secondary flex-grow-1">
                                        @Localizer["Home_SusceptibilityRankingBody"]
                                    </p>
                                    <a href="spreadsheet-viewer" class="btn btn-primary mt-2">@Localizer["Home_OpenRanking"]</a>
                                </div>
                            </div>
                        </div>

                        <div class="col">
                            <div class="card h-100">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">@Localizer["Home_AbbreviationMappingsTitle"]</h5>
                                    <p class="card-text text-body-secondary flex-grow-1">
                                        @Localizer["Home_AbbreviationMappingsBody"]
                                    </p>
                                    <a href="antibiotic-mappings" class="btn btn-outline-primary mt-2">@Localizer["Home_OpenMappings"]</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Management Section (Rendered only for permitted roles) -->
                <AuthorizeView Policy="@AuthorizationPolicyNames.CanManageSpreadsheet" Context="manageSpreadsheetState">
                    <Authorized>
                        <section class="mb-4">
                            <h2 class="h4 mb-3">@Localizer["Home_LaboratoryAdministrationHeading"]</h2>
                            <div class="row row-cols-1 row-cols-md-2 g-3">
                                <div class="col">
                                    <div class="card h-100">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">@Localizer["Home_UploadSpreadsheetTitle"]</h5>
                                            <p class="card-text text-body-secondary flex-grow-1">
                                                @Localizer["Home_UploadSpreadsheetBody"]
                                            </p>
                                            <a href="upload" class="btn btn-outline-secondary mt-2">@Localizer["Home_UploadPage"]</a>
                                        </div>
                                    </div>
                                </div>

                                <AuthorizeView Policy="@AuthorizationPolicyNames.CanManageUserRoles" Context="manageRolesState">
                                    <Authorized>
                                        <div class="col">
                                            <div class="card h-100">
                                                <div class="card-body d-flex flex-column">
                                                    <h5 class="card-title">@Localizer["Home_UserAndTeamSettingsTitle"]</h5>
                                                    <p class="card-text text-body-secondary flex-grow-1">
                                                        @Localizer["Home_UserAndTeamSettingsBody"]
                                                    </p>
                                                    <a href="settings/user-roles" class="btn btn-outline-secondary mt-2">@Localizer["Home_ManageUsers"]</a>
                                                </div>
                                            </div>
                                        </div>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </section>
                    </Authorized>
                </AuthorizeView>
            </Authorized>

            <NotAuthorized>
                <div class="alert alert-warning mt-3" role="alert">
                    <h4 class="alert-heading">@Localizer["Home_AwaitingActivationHeading"]</h4>
                    <p class="mb-2">
                        @Localizer["Home_AwaitingActivationBody"]
                    </p>
                    <hr />
                    <p class="mb-0 text-body-secondary small">
                        @Localizer["Home_AwaitingActivationFooter"]
                    </p>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </Authorized>
</AuthorizeView>

@code {
    /// <summary>
    /// The name the "Signed in as" line shows. Non-technical users know their
    /// own name, not the email the account was made with, so the display name
    /// is preferred; the email and a generic label cover the fallbacks.
    /// </summary>
    private string signedInAs = string.Empty;

    /// <summary>
    /// True until a display name or email has been found. A separate flag is
    /// used instead of comparing <see cref="signedInAs"/> against its own
    /// placeholder, because that placeholder is a translated string and a
    /// translated string is not a stable comparison target.
    /// </summary>
    private bool isUsingPlaceholderName = true;

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();
        string? userId =
            authenticationState.User.FindFirstValue(ClaimTypes.NameIdentifier);

        if (!string.IsNullOrEmpty(userId))
        {
            string requiredUserId = userId;
            ApplicationUser? user = await UserManager.FindByIdAsync(requiredUserId);

            if (user is not null && user.DisplayName.Length > 0)
            {
                signedInAs = user.DisplayName;
                isUsingPlaceholderName = false;
            }
        }

        // A display name could be blank (the seeder does not set one for every
        // account); fall back to the email the claim already carries, then to
        // the generic label.
        string? emailFallback = authenticationState.User.FindFirstValue(ClaimTypes.Email);

        if (isUsingPlaceholderName && !string.IsNullOrEmpty(emailFallback))
        {
            signedInAs = emailFallback;
            isUsingPlaceholderName = false;
        }

        if (isUsingPlaceholderName)
        {
            signedInAs = Localizer["Home_AuthenticatedUser"];
        }
    }
}
