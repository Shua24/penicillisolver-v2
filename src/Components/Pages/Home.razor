@page "/"
@using Microsoft.AspNetCore.Authorization
@using penicillisolver_v2.Domain.Constants

<PageTitle>PenicilliSolver</PageTitle>

<h1>PenicilliSolver</h1>

<p>
    Antimicrobial resistance data for the laboratory, shared from one reference
    spreadsheet. Every reader sees the same file.
</p>

<AuthorizeView Context="signedInState">
    <NotAuthorized>
        <section class="mb-4">
            <h2>Sign in to continue</h2>
            <p>
                This application is restricted to laboratory and clinical staff.
                Accounts are created by registration and activated by a clinical
                pathologist before they can read anything.
            </p>
            <p>
                <a class="btn btn-primary" href="Account/Login">Log in</a>
                <a class="btn btn-secondary" href="Account/Register">Register</a>
            </p>
        </section>
    </NotAuthorized>

    <Authorized>
        <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
            <div>
                <span class="text-body-secondary">Signed in as</span>
                <strong>@(signedInState.User.Identity?.Name ?? "Authenticated User")</strong>
            </div>
            <span class="badge bg-secondary">Signed In</span>
        </div>

        @* A pending account can sign in but holds no permissions, so it reaches
           no other page. Say so here rather than leaving a signed-in user on a
           blank home screen wondering why every link is missing. *@
        <AuthorizeView Policy="@AuthorizationPolicyNames.CanReadSpreadsheet" Context="readState">
            <Authorized>
                <!-- Clinical Tools -->
                <section class="mb-4">
                    <h2 class="h4 mb-3">Clinical Tools</h2>
                    <div class="row row-cols-1 row-cols-md-2 g-3">
                        <div class="col">
                            <div class="card h-100">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">Resistance Ranking</h5>
                                    <p class="card-text text-body-secondary flex-grow-1">
                                        Analyze organism susceptibility and view the top resistant antibiotics
                                        from the reference spreadsheet.
                                    </p>
                                    <a href="spreadsheet-viewer" class="btn btn-primary mt-2">Open Ranking</a>
                                </div>
                            </div>
                        </div>

                        <div class="col">
                            <div class="card h-100">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title">Abbreviation Mappings</h5>
                                    <p class="card-text text-body-secondary flex-grow-1">
                                        Look up and manage definitions for antibiotic codes and abbreviations
                                        used across laboratory reports.
                                    </p>
                                    <a href="antibiotic-mappings" class="btn btn-outline-primary mt-2">Open Mappings</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- Management Section (Rendered only for permitted roles) -->
                <AuthorizeView Policy="@AuthorizationPolicyNames.CanManageSpreadsheet" Context="manageSpreadsheetState">
                    <Authorized>
                        <section class="mb-4">
                            <h2 class="h4 mb-3">Laboratory Administration</h2>
                            <div class="row row-cols-1 row-cols-md-2 g-3">
                                <div class="col">
                                    <div class="card h-100">
                                        <div class="card-body d-flex flex-column">
                                            <h5 class="card-title">Upload Spreadsheet</h5>
                                            <p class="card-text text-body-secondary flex-grow-1">
                                                Replace or update the active reference AMR spreadsheet (CSV or XLSX)
                                                for all clinicians and laboratory staff.
                                            </p>
                                            <a href="upload" class="btn btn-outline-secondary mt-2">Upload Page</a>
                                        </div>
                                    </div>
                                </div>

                                <AuthorizeView Policy="@AuthorizationPolicyNames.CanManageUserRoles" Context="manageRolesState">
                                    <Authorized>
                                        <div class="col">
                                            <div class="card h-100">
                                                <div class="card-body d-flex flex-column">
                                                    <h5 class="card-title">User &amp; Team Settings</h5>
                                                    <p class="card-text text-body-secondary flex-grow-1">
                                                        Activate registered accounts, assign roles, and grant permissions
                                                        to the Infectious Disease Control Team.
                                                    </p>
                                                    <a href="settings/user-roles" class="btn btn-outline-secondary mt-2">Manage Users</a>
                                                </div>
                                            </div>
                                        </div>
                                    </Authorized>
                                </AuthorizeView>
                            </div>
                        </section>
                    </Authorized>
                </AuthorizeView>
            </Authorized>

            <NotAuthorized>
                <div class="alert alert-warning mt-3" role="alert">
                    <h4 class="alert-heading">Awaiting Account Activation</h4>
                    <p class="mb-2">
                        Your account is registered but has not yet been assigned a clinical role.
                        A clinical pathologist has to assign it a role before you can read the spreadsheet.
                        Nothing is wrong with your sign-in: this is the deliberate gate that keeps registration
                        from granting access on its own.
                    </p>
                    <hr />
                    <p class="mb-0 text-body-secondary small">
                        If you need access, please contact a clinical pathologist to activate your account.
                    </p>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </Authorized>
</AuthorizeView>
