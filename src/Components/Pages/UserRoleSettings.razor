@page "/settings/user-roles"
@using Microsoft.AspNetCore.Authorization
@using penicillisolver_v2.Components.Account.Shared
@using penicillisolver_v2.Domain.Constants
@using penicillisolver_v2.Domain.Enums
@using penicillisolver_v2.Services
@attribute [Authorize(Policy = AuthorizationPolicyNames.CanManageUserRoles)]
@rendermode InteractiveServer

@inject UserAdministrationService AdministrationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@Localizer["Settings_Title"]</PageTitle>

<h1>@Localizer["Settings_Heading"]</h1>

<StatusMessage Message="@statusMessage" IsError="@statusFailed" />

@if (isLoading)
{
    <p><em>@Localizer["Settings_Loading"]</em></p>
}
else
{
    <section class="mb-5">
        <h2>@Localizer["Settings_AccountsHeading"]</h2>
        <p>
            @Localizer["Settings_AccountsHelp"]
        </p>

        <table class="table">
            <thead>
                <tr>
                    <th scope="col">@Localizer["Settings_ColumnName"]</th>
                    <th scope="col">@Localizer["Settings_ColumnEmail"]</th>
                    <th scope="col">@Localizer["Settings_ColumnRole"]</th>
                    <th scope="col">@Localizer["Settings_ColumnStatus"]</th>
                    <th scope="col">@Localizer["Settings_ColumnSetRole"]</th>
                    <th scope="col">@Localizer["Settings_ColumnSetStatus"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (UserAccountSummary account in accounts)
                {
                    <tr>
                        <td>
                            @account.DisplayName
                            @if (account.LastPasswordResetAtUtc is not null)
                            {
                                <div class="form-text">
                                    @DescribeLastReset(account)
                                </div>
                            }
                        </td>
                        <td>@account.Email</td>
                        <td>
                            @(string.IsNullOrEmpty(account.RoleName)
                                ? "—"
                                : DescribeRole(account.RoleName))
                        </td>
                        <td>@account.AccountStatus</td>
                        <td>
                            <select class="form-select"
                                    @onchange="eventArgs => ChangeRoleAsync(account, eventArgs)">
                                <option value="">@Localizer["Settings_ChooseRole"]</option>
                                @foreach (string roleName in AssignableRoleNames)
                                {
                                    <option value="@roleName"
                                            selected="@(account.RoleName == roleName)">
                                        @DescribeRole(roleName)
                                    </option>
                                }
                            </select>
                        </td>
                        <td>
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button"
                                        class="btn btn-sm btn-success"
                                        @onclick="() => ChangeStatusAsync(account, AccountStatus.Active)">
                                    @Localizer["Settings_Activate"]
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        @onclick="() => ChangeStatusAsync(account, AccountStatus.Disabled)">
                                    @Localizer["Settings_Disable"]
                                </button>
                                @if (pendingResetUserId == account.UserId)
                                {
                                    <div class="w-100 mt-2">
                                        <p class="mb-1">
                                            @Localizer["Settings_ResetPasswordPrompt", account.DisplayName]
                                        </p>
                                        <input type="password"
                                               class="form-control form-control-sm mb-2"
                                               autocomplete="new-password"
                                               placeholder="@Localizer["Settings_ResetPasswordPlaceholder"]"
                                               @bind="resetPassword" />
                                        <button type="button"
                                                class="btn btn-sm btn-warning"
                                                disabled="@isResetting"
                                                @onclick="() => ResetPasswordAsync(account)">
                                            @(isResetting
                                                ? Localizer["Settings_Resetting"]
                                                : Localizer["Settings_ConfirmReset"])
                                        </button>
                                        <button type="button"
                                                class="btn btn-sm btn-secondary"
                                                disabled="@isResetting"
                                                @onclick="CancelReset">
                                            @Localizer["Settings_Cancel"]
                                        </button>
                                    </div>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-outline-warning"
                                            disabled="@isResetting"
                                            @onclick="() => BeginReset(account)">
                                        @Localizer["Settings_ResetPassword"]
                                    </button>
                                }
                                @if (pendingDeleteUserId == account.UserId)
                                {
                                    <span>@Localizer["Settings_DeleteConfirmPrompt", account.DisplayName]</span>
                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            disabled="@isDeleting"
                                            @onclick="() => DeleteAccountAsync(account)">
                                        @(isDeleting ? Localizer["Settings_Deleting"] : Localizer["Settings_ConfirmDelete"])
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-secondary"
                                            disabled="@isDeleting"
                                            @onclick="() => pendingDeleteUserId = null">
                                        @Localizer["Settings_Cancel"]
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            disabled="@isDeleting"
                                            @onclick="() => pendingDeleteUserId = account.UserId">
                                        @Localizer["Settings_Delete"]
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section>
        <h2>@Localizer["Settings_TeamPermissionsHeading"]</h2>
        <p>
            @Localizer["Settings_TeamPermissionsHelp"]
        </p>

        <div class="form-check form-switch mb-2">
            <input class="form-check-input"
                   type="checkbox"
                   id="team-can-update"
                   checked="@teamPermissions.CanUpdateSpreadsheet"
                   @onchange="eventArgs => ToggleTeamPermissionAsync(eventArgs, PermissionToggle.Update)" />
            <label class="form-check-label" for="team-can-update">
                @Localizer["Settings_TeamMayUpdate"]
            </label>
        </div>

        <div class="form-check form-switch mb-2">
            <input class="form-check-input"
                   type="checkbox"
                   id="team-can-delete"
                   checked="@teamPermissions.CanDeleteSpreadsheet"
                   @onchange="eventArgs => ToggleTeamPermissionAsync(eventArgs, PermissionToggle.Delete)" />
            <label class="form-check-label" for="team-can-delete">
                @Localizer["Settings_TeamMayDelete"]
            </label>
        </div>
    </section>
}
