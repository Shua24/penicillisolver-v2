@page "/settings/user-roles"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using penicillisolver_v2.Components.Account.Shared
@using penicillisolver_v2.Domain.Constants
@using penicillisolver_v2.Domain.Enums
@using penicillisolver_v2.Services
@attribute [Authorize(Policy = AuthorizationPolicyNames.CanManageUserRoles)]
@rendermode InteractiveServer

@inject UserAdministrationService AdministrationService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@Localizer["Settings_Title"]</PageTitle>

<h1>@Localizer["Settings_Heading"]</h1>

<StatusMessage Message="@statusMessage" IsError="@statusFailed" />

@if (isLoading)
{
    <p><em>@Localizer["Settings_Loading"]</em></p>
}
else
{
    <section class="mb-5">
        <h2>@Localizer["Settings_AccountsHeading"]</h2>
        <p>
            @Localizer["Settings_AccountsHelp"]
        </p>

        <table class="table">
            <thead>
                <tr>
                    <th scope="col">@Localizer["Settings_ColumnName"]</th>
                    <th scope="col">@Localizer["Settings_ColumnEmail"]</th>
                    <th scope="col">@Localizer["Settings_ColumnRole"]</th>
                    <th scope="col">@Localizer["Settings_ColumnStatus"]</th>
                    <th scope="col">@Localizer["Settings_ColumnSetRole"]</th>
                    <th scope="col">@Localizer["Settings_ColumnSetStatus"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (UserAccountSummary account in accounts)
                {
                    <tr>
                        <td>@account.DisplayName</td>
                        <td>@account.Email</td>
                        <td>
                            @(string.IsNullOrEmpty(account.RoleName)
                                ? "—"
                                : DescribeRole(account.RoleName))
                        </td>
                        <td>@account.AccountStatus</td>
                        <td>
                            <select class="form-select"
                                    @onchange="eventArgs => ChangeRoleAsync(account, eventArgs)">
                                <option value="">@Localizer["Settings_ChooseRole"]</option>
                                @foreach (string roleName in AssignableRoleNames)
                                {
                                    <option value="@roleName"
                                            selected="@(account.RoleName == roleName)">
                                        @DescribeRole(roleName)
                                    </option>
                                }
                            </select>
                        </td>
                        <td>
                            <div class="d-flex gap-2">
                                <button type="button"
                                        class="btn btn-sm btn-success"
                                        @onclick="() => ChangeStatusAsync(account, AccountStatus.Active)">
                                    @Localizer["Settings_Activate"]
                                </button>
                                <button type="button"
                                        class="btn btn-sm btn-outline-danger"
                                        @onclick="() => ChangeStatusAsync(account, AccountStatus.Disabled)">
                                    @Localizer["Settings_Disable"]
                                </button>
                                @if (pendingDeleteUserId == account.UserId)
                                {
                                    <span>@Localizer["Settings_DeleteConfirmPrompt", account.DisplayName]</span>
                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            disabled="@isDeleting"
                                            @onclick="() => DeleteAccountAsync(account)">
                                        @(isDeleting ? Localizer["Settings_Deleting"] : Localizer["Settings_ConfirmDelete"])
                                    </button>
                                    <button type="button"
                                            class="btn btn-sm btn-secondary"
                                            disabled="@isDeleting"
                                            @onclick="() => pendingDeleteUserId = null">
                                        @Localizer["Settings_Cancel"]
                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            disabled="@isDeleting"
                                            @onclick="() => pendingDeleteUserId = account.UserId">
                                        @Localizer["Settings_Delete"]
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section>
        <h2>@Localizer["Settings_TeamPermissionsHeading"]</h2>
        <p>
            @Localizer["Settings_TeamPermissionsHelp"]
        </p>

        <div class="form-check form-switch mb-2">
            <input class="form-check-input"
                   type="checkbox"
                   id="team-can-update"
                   checked="@teamPermissions.CanUpdateSpreadsheet"
                   @onchange="eventArgs => ToggleTeamPermissionAsync(eventArgs, PermissionToggle.Update)" />
            <label class="form-check-label" for="team-can-update">
                @Localizer["Settings_TeamMayUpdate"]
            </label>
        </div>

        <div class="form-check form-switch mb-2">
            <input class="form-check-input"
                   type="checkbox"
                   id="team-can-delete"
                   checked="@teamPermissions.CanDeleteSpreadsheet"
                   @onchange="eventArgs => ToggleTeamPermissionAsync(eventArgs, PermissionToggle.Delete)" />
            <label class="form-check-label" for="team-can-delete">
                @Localizer["Settings_TeamMayDelete"]
            </label>
        </div>
    </section>
}

@code {
    private static readonly string[] AssignableRoleNames =
    [
        ApplicationRoleNames.ClinicalPathologist,
        ApplicationRoleNames.OtherDoctor,
        ApplicationRoleNames.InfectiousDiseaseControlTeam,
    ];

    private IReadOnlyList<UserAccountSummary> accounts = [];
    private TeamPermissionSummary teamPermissions = new(
        ApplicationRoleNames.InfectiousDiseaseControlTeam,
        CanUpdateSpreadsheet: false,
        CanDeleteSpreadsheet: false);
    private string? statusMessage;

    /// <summary>
    /// Whether <see cref="statusMessage"/> describes a failure. Set alongside
    /// the message so the banner's severity is explicit rather than inferred
    /// from an "Error" prefix, which cannot survive translation.
    /// </summary>
    private bool statusFailed;
    private string? actingUserId;
    private bool isLoading = true;

    /// <summary>Which team permission a toggle controls.</summary>
    private enum PermissionToggle
    {
        /// <summary>The team may replace the current spreadsheet.</summary>
        Update,

        /// <summary>The team may remove the current spreadsheet.</summary>
        Delete,
    }

    protected override async Task OnInitializedAsync()
    {
        actingUserId = await ResolveCurrentUserIdAsync();

        await ReloadAsync();

        isLoading = false;
    }

    private async Task ReloadAsync()
    {
        accounts = await AdministrationService.GetAccountsAsync();
        teamPermissions = await AdministrationService.GetTeamPermissionsAsync();
    }

    /// <summary>
    /// The localized label for a role token. The token itself stays as the
    /// option value because it is what the database stores, but what the reader
    /// sees is translated here at the point of display. The service layer keeps
    /// its own English mapping; this page is the user facing side.
    /// </summary>
    private string DescribeRole(string roleName)
    {
        string resourceKey = roleName switch
        {
            ApplicationRoleNames.ClinicalPathologist => "Role_ClinicalPathologist",
            ApplicationRoleNames.OtherDoctor => "Role_OtherDoctor",
            ApplicationRoleNames.InfectiousDiseaseControlTeam => "Role_InfectiousDiseaseControlTeam",
            _ => string.Empty,
        };

        if (resourceKey.Length == 0)
        {
            return ApplicationRoleDisplayNames.DisplayNameOf(roleName);
        }

        return Localizer[resourceKey];
    }

    private async Task ChangeRoleAsync(UserAccountSummary account, ChangeEventArgs eventArgs)
    {
        if (actingUserId is null)
        {
            statusFailed = true;
            statusMessage = Localizer["Status_SessionExpired"];
            return;
        }

        string? newRoleName = eventArgs.Value?.ToString();

        if (string.IsNullOrWhiteSpace(newRoleName))
        {
            return;
        }

        AdministrationResult result = await AdministrationService.SetRoleAsync(
            actingUserId,
            account.UserId,
            newRoleName);

        await ApplyResultAsync(result);
    }

    private async Task ChangeStatusAsync(UserAccountSummary account, AccountStatus newState)
    {
        if (actingUserId is null)
        {
            statusFailed = true;
            statusMessage = Localizer["Status_SessionExpired"];
            return;
        }

        AdministrationResult result = await AdministrationService.SetAccountStatusAsync(
            actingUserId,
            account.UserId,
            newState);

        await ApplyResultAsync(result);
    }

    private async Task ToggleTeamPermissionAsync(ChangeEventArgs eventArgs, PermissionToggle toggle)
    {
        if (actingUserId is null)
        {
            statusFailed = true;
            statusMessage = Localizer["Status_SessionExpired"];
            return;
        }

        bool isChecked = eventArgs.Value is true;

        bool canUpdate = teamPermissions.CanUpdateSpreadsheet;
        bool canDelete = teamPermissions.CanDeleteSpreadsheet;

        if (toggle == PermissionToggle.Update)
        {
            canUpdate = isChecked;
        }
        else
        {
            canDelete = isChecked;
        }

        AdministrationResult result = await AdministrationService.SetTeamPermissionsAsync(
            actingUserId,
            canUpdate,
            canDelete);

        await ApplyResultAsync(result);
    }

    private async Task ApplyResultAsync(AdministrationResult result)
    {
        statusFailed = !result.IsSuccess;

        statusMessage = result.IsSuccess
            ? result.Message
            : Localizer["Status_ErrorPrefix"] + result.Message;

        await ReloadAsync();
    }

    private async Task<string?> ResolveCurrentUserIdAsync()
    {
        AuthenticationState authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        Claim? nameIdentifierClaim =
            authenticationState.User.FindFirst(ClaimTypes.NameIdentifier);

        string? userId = nameIdentifierClaim?.Value;

        return userId;
    }
}
