@page "/Error"
@using System.Diagnostics

<PageTitle>@Localizer["Error_Title"]</PageTitle>

<h1 class="text-danger">@Localizer["Error_Heading"]</h1>
<h2 class="text-danger">@Localizer["Error_Occurred"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@Localizer["Error_RequestId"]</strong> <code>@RequestId</code>
    </p>
}

<h3>@Localizer["Error_DevelopmentModeHeading"]</h3>
<p>
    @Localizer["Error_DevelopmentModeBody"]
</p>
<p>
    <strong>@Localizer["Error_DevelopmentWarning"]</strong>
    @Localizer["Error_DevelopmentHint"]
</p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
