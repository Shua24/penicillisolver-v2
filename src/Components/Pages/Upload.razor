@page "/upload"
@using System.Security.Claims
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Identity
@using penicillisolver_v2.Domain.Constants
@using penicillisolver_v2.Domain.Entities
@using penicillisolver_v2.Domain.Enums
@using penicillisolver_v2.Services
@using penicillisolver_v2.Components.Account.Shared
@attribute [Authorize(Policy = AuthorizationPolicyNames.CanManageSpreadsheet)]
@rendermode InteractiveServer

@inject SpreadsheetUploadService UploadService
@inject SpreadsheetQueryService QueryService
@inject AuthenticationStateProvider AuthenticationStateProvider

@* The accept attribute is a convenience for the file picker only. The server
   re-validates the extension through SpreadsheetFormatResolver, because a
   browser-supplied hint is not a security boundary. *@

<PageTitle>@Localizer["Upload_Title"]</PageTitle>

<h1>@Localizer["Upload_Heading"]</h1>

<p>
    @Localizer["Upload_Intro"]
</p>

<StatusMessage Message="@statusMessage" IsError="@statusFailed" />

@if (currentUpload is not null)
{
    <section class="mb-4">
        <h2>@Localizer["Upload_CurrentSpreadsheetHeading"]</h2>
        <dl class="row">
            <dt class="col-sm-3">@Localizer["Upload_FieldFileName"]</dt>
            <dd class="col-sm-9">@currentUpload.OriginalFileName</dd>

            <dt class="col-sm-3">@Localizer["Upload_FieldUploaded"]</dt>
            <dd class="col-sm-9">@currentUpload.UploadedAtUtc.ToLocalTime().ToString("f")</dd>

            <dt class="col-sm-3">@Localizer["Upload_FieldFormat"]</dt>
            <dd class="col-sm-9">@currentUpload.FileFormat</dd>

            <dt class="col-sm-3">@Localizer["Upload_FieldOrganisms"]</dt>
            <dd class="col-sm-9">@currentUpload.OrganismCount</dd>

            <dt class="col-sm-3">@Localizer["Upload_FieldAntibiotics"]</dt>
            <dd class="col-sm-9">@currentUpload.AntibioticCount</dd>
        </dl>
    </section>

    @if (antibioticNames.Count > 0)
    {
        <section class="mb-4">
            <h2>@Localizer["Upload_AntibioticsInFileHeading"]</h2>
            <p>
                @Localizer["Upload_AntibioticsInFileBody"]
            </p>
            <ul>
                @foreach (string antibioticName in antibioticNames)
                {
                    <li>
                        <AntibioticNameDisplay
                            SpreadsheetUploadId="currentUpload.Id"
                            Abbreviation="@antibioticName" />
                    </li>
                }
            </ul>
        </section>
    }
}
else
{
    <p>@Localizer["Upload_NoSpreadsheet"]</p>
}

<section>
    <h2>@(currentUpload is null ? Localizer["Upload_ChooseFile"] : Localizer["Upload_ReplaceFile"])</h2>

    <div class="mb-3">
        <InputFile OnChange="OnFileSelectedAsync" accept=".csv,.xlsx" class="form-control" />
        <div class="form-text">@Localizer["Upload_AcceptedFormats"]</div>
    </div>

    @if (selectedFileName is not null && !isAwaitingConfirmation)
    {
        <p>
            @Localizer["Upload_Selected"] <strong>@selectedFileName</strong>
            <button type="button" class="btn btn-link" @onclick="ClearSelection">@Localizer["Upload_Clear"]</button>
        </p>
    }

    @if (isAwaitingConfirmation)
    {
        <div class="alert alert-warning" role="alert">
            <p>
                @Localizer["Upload_ConfirmReplace", selectedFileName!]
            </p>
            <button type="button" class="btn btn-danger" @onclick="ConfirmAndUploadAsync">
                @Localizer["Upload_ConfirmReplaceButton"]
            </button>
            <button type="button" class="btn btn-secondary" @onclick="ClearSelection">
                @Localizer["Upload_Cancel"]
            </button>
        </div>
    }

    @if (isUploading)
    {
        <p><em>@Localizer["Upload_Uploading"]</em></p>
    }
</section>

@code {
    private SpreadsheetUpload? currentUpload;
    private IReadOnlyList<string> antibioticNames = [];
    private IBrowserFile? selectedFile;
    private string? selectedFileName;
    private string? statusMessage;

    /// <summary>
    /// Whether <see cref="statusMessage"/> describes a failure. Set alongside
    /// every failure message so the alert is styled as an error without the
    /// component having to guess from the text.
    /// </summary>
    private bool statusFailed;
    private bool isAwaitingConfirmation;
    private bool isUploading;
    private string? uploadingUserId;

    protected override async Task OnInitializedAsync()
    {
        currentUpload = await QueryService.GetCurrentUploadAsync();

        await LoadAntibioticNamesAsync();
    }

    /// <summary>
    /// Reads the antibiotic names from the current document so the page can show
    /// each one with its mapped meaning.
    /// </summary>
    private async Task LoadAntibioticNamesAsync()
    {
        SpreadsheetDocument? document = await QueryService.GetCurrentDocumentAsync();

        if (document is null)
        {
            antibioticNames = [];

            return;
        }

        antibioticNames = document.AntibioticNames;
    }

    private async Task OnFileSelectedAsync(InputFileChangeEventArgs eventArgs)
    {
        statusMessage = null;
        statusFailed = false;

        IBrowserFile file = eventArgs.File;

        // A single reference file, so an ambiguity is resolved by refusing.
        if (eventArgs.FileCount != 1)
        {
            statusMessage = Localizer["Upload_ChooseExactlyOneFile"];
            statusFailed = true;

            return;
        }

        selectedFile = file;
        selectedFileName = file.Name;

        // Never overwrite the working spreadsheet on a single click: if one
        // exists, make the user confirm the replacement first.
        if (currentUpload is null)
        {
            isAwaitingConfirmation = false;
            await PerformUploadAsync();
        }
        else
        {
            isAwaitingConfirmation = true;
        }
    }

    private async Task ConfirmAndUploadAsync()
    {
        isAwaitingConfirmation = false;
        await PerformUploadAsync();
    }

    private async Task PerformUploadAsync()
    {
        if (selectedFile is null)
        {
            return;
        }

        isUploading = true;
        statusMessage = null;
        StateHasChanged();

        try
        {
            uploadingUserId = await ResolveCurrentUserIdAsync();

            if (uploadingUserId is null)
            {
                statusMessage = Localizer["Status_SessionExpired"];
                statusFailed = true;
                return;
            }

            // The browser file is read through a bounded stream so a hostile or
            // mistaken large file cannot exhaust memory before the size check.
            await using Stream fileStream = selectedFile.OpenReadStream(
                SpreadsheetUploadService.DefaultMaximumFileSizeBytes);

            SpreadsheetUploadResult uploadResult = await UploadService.AcceptUploadAsync(
                fileStream,
                selectedFile.Name,
                uploadingUserId);

            statusMessage = uploadResult.IsSuccess
                ? uploadResult.Message
                : $"{Localizer["Status_ErrorPrefix"]}{uploadResult.Message}";
            statusFailed = !uploadResult.IsSuccess;

            if (uploadResult.IsSuccess)
            {
                currentUpload = await QueryService.GetCurrentUploadAsync();
                await LoadAntibioticNamesAsync();
                selectedFile = null;
                selectedFileName = null;
            }
        }
        catch (InvalidOperationException exception)
        {
            // InputFile raises this when the file exceeds the permitted size.
            // Reflect the configured limit rather than the browser's message.
            statusMessage =
                $"{Localizer["Upload_FileTooLargeForPicker"]} ({exception.Message})";
            statusFailed = true;
        }
        finally
        {
            isUploading = false;
        }
    }

    private void ClearSelection()
    {
        selectedFile = null;
        selectedFileName = null;
        isAwaitingConfirmation = false;
    }

    private async Task<string?> ResolveCurrentUserIdAsync()
    {
        AuthenticationState authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        Claim? nameIdentifierClaim =
            authenticationState.User.FindFirst(ClaimTypes.NameIdentifier);

        string? userId = nameIdentifierClaim?.Value;

        return userId;
    }
}
