@inherits LayoutComponentBase

@using penicillisolver_v2.Components.Account.Shared

@* Mounted here so every page, interactive or not, pins the culture the language
   switcher stored. See CultureProvider.razor.cs for why the request pipeline
   alone is not enough for an interactive circuit. *@
<CultureProvider />

@* The interactive half of the must-change gate: a circuit opened before the
   password was reset must not keep rendering the page it was opened on. *@
<RedirectToChangePassword />

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <!-- <div class="top-row px-4">
            <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">About</a>
        </div> -->

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    @Localizer["Layout_UnhandledError"]
    <a href="." class="reload">@Localizer["Layout_Reload"]</a>
    <span class="dismiss">🗙</span>
</div>
