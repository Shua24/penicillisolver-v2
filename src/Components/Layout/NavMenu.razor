@using penicillisolver_v2.Domain.Constants
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">
            <img src="favicon.png" alt="PenicilliSolver logo" width="30" height="30" class="d-inline-block align-top" />
            PenicilliSolver
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <AuthorizeView Policy="@AuthorizationPolicyNames.CanReadSpreadsheet">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="spreadsheet-viewer">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Resistance ranking
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="antibiotic-mappings">
                        <span class="bi bi-tags-fill-nav-menu" aria-hidden="true"></span> Abbreviation mappings
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="@AuthorizationPolicyNames.CanManageSpreadsheet">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="upload">
                        <span class="bi bi-upload-nav-menu" aria-hidden="true"></span> Upload spreadsheet
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView Policy="@AuthorizationPolicyNames.CanManageUserRoles">
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="settings/user-roles">
                        <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> User and team settings
                    </NavLink>
                </div>
            </Authorized>
        </AuthorizeView>

        <AuthorizeView>
            <Authorized>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="returnUrl" value="Account/Logout" />
                        <button type="submit" class="nav-link btn btn-link">Log out</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> Log in
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-plus-fill-nav-menu" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

