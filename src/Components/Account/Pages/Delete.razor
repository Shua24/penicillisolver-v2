@page "/Account/Delete"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using penicillisolver_v2.Domain.Entities
@using penicillisolver_v2.Services
@using penicillisolver_v2.Components.Account.Shared

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject UserAdministrationService AdministrationService
@inject ILogger<Delete> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>@Localizer["DeleteAccount_Title"]</PageTitle>

<h1>@Localizer["DeleteAccount_Heading"]</h1>
<div class="row">
    <div class="col-lg-6">
        <StatusMessage Message="@Message" IsError="@(Message is not null)" />

        @if (CurrentUser is null)
        {
            <div class="alert alert-warning" role="alert">
                <strong>@Localizer["DeleteAccount_NotSignedInHeading"]</strong>
                @Localizer["DeleteAccount_NotSignedInBody"]
                <a class="btn btn-primary mt-2" href="Account/Login">@Localizer["Nav_LogIn"]</a>
            </div>
        }
        else
        {
            <EditForm Model="Input" method="post" OnValidSubmit="DeleteAccountAsync" FormName="delete-account">
                <DataAnnotationsValidator />
                <h2>@Localizer["DeleteAccount_SubHeading"]</h2>
                <hr />
                <p class="text-muted">
                    @Localizer["DeleteAccount_Warning", CurrentUser.DisplayName, CurrentUser.Email ?? string.Empty]
                </p>
                <div class="form-floating mb-3">
                    <InputText @bind-Value="Input.ConfirmationText"
                               id="Input.ConfirmationText"
                               class="form-control"
                               placeholder="@Localizer["DeleteAccount_ConfirmationPlaceholder"]" />
                    <label for="Input.ConfirmationText">@Localizer["DeleteAccount_ConfirmationLabel"]</label>
                    <ValidationMessage For="() => Input.ConfirmationText" class="text-danger" />
                </div>
                <button type="submit" class="w-100 btn btn-lg btn-danger">@Localizer["DeleteAccount_Submit"]</button>
            </EditForm>
        }
    </div>
</div>

@code {
    /// <summary>
    /// The phrase a user must type to arm the delete button. It is localized, so
    /// an Indonesian reader types the Indonesian phrase; the regular expression
    /// below is anchored to whatever this resolves to, which keeps the check and
    /// the instruction on screen in agreement.
    /// </summary>
    private string ConfirmationPhrase => Localizer["DeleteAccount_ConfirmationPlaceholder"];

    /// <summary>The account about to be deleted, or null when not signed in.</summary>
    private ApplicationUser? CurrentUser;

    /// <summary>A refusal message from the service, shown above the form.</summary>
    private string? Message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        string? userId = UserManager.GetUserId(HttpContext.User);

        if (!string.IsNullOrEmpty(userId))
        {
            CurrentUser = await UserManager.FindByIdAsync(userId);
        }
    }

    public async Task DeleteAccountAsync(EditContext editContext)
    {
        ArgumentNullException.ThrowIfNull(editContext);

        if (CurrentUser is null)
        {
            return;
        }

        // The confirmation phrase is compared here rather than through a
        // validation attribute, because the expected value depends on the
        // request culture and an attribute cannot read the localizer.
        string typedConfirmation = (Input.ConfirmationText ?? string.Empty).Trim();

        if (!string.Equals(typedConfirmation, ConfirmationPhrase, StringComparison.OrdinalIgnoreCase))
        {
            Message = Localizer["Status_ErrorPrefix"] + Localizer["DeleteAccount_ConfirmationHint"];
            return;
        }

        string actingUserId = CurrentUser.Id;

        // The voluntary self-delete path: it is exempt from the last-active
        // pathologist guard by design, because it is the escape hatch. If it
        // empties the pathologist pool, the bootstrap seeder repairs it on next
        // startup.
        AdministrationResult result = await AdministrationService.DeleteUserAsync(
            actingUserId,
            actingUserId,
            isSelfDelete: true);

        if (!result.IsSuccess)
        {
            Message = Localizer["Status_ErrorPrefix"] + result.Message;
            return;
        }

        await SignInManager.SignOutAsync();

        Logger.LogInformation("User {UserId} deleted their own account.", actingUserId);

        RedirectManager.RedirectToWithStatus(
            "Account/Login",
            Localizer["DeleteAccount_Deleted"],
            HttpContext);
    }

    private sealed class InputModel
    {
        [Required]
        public string ConfirmationText { get; set; } = "";
    }
}
