@page "/Account/Register"

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using penicillisolver_v2.Domain.Constants
@using penicillisolver_v2.Domain.Entities
@using penicillisolver_v2.Domain.Enums
@using penicillisolver_v2.Services
@using penicillisolver_v2.Components.Account.Shared

@inject UserManager<ApplicationUser> UserManager
@inject IUserStore<ApplicationUser> UserStore
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<Register> Logger
@inject IdentityRedirectManager RedirectManager

<PageTitle>@Localizer["Register_Title"]</PageTitle>

<h1>@Localizer["Register_Heading"]</h1>

<div class="row">
    <div class="col-lg-6">
        <StatusMessage Message="@Message" IsError="@(identityErrors is not null)" />
        <EditForm Model="Input" method="post" OnValidSubmit="RegisterUser" FormName="register">
            <DataAnnotationsValidator />
            <h2>@Localizer["Register_SubHeading"]</h2>
            <hr />
            <p class="text-muted">
                @Localizer["Register_PendingNotice"]
            </p>
            <ValidationSummary class="text-danger" role="alert" />
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.DisplayName" id="Input.DisplayName" class="form-control" autocomplete="name" aria-required="true" placeholder="@Localizer["Register_DisplayNamePlaceholder"]" />
                <label for="Input.DisplayName">@Localizer["Register_DisplayNameLabel"]</label>
                <ValidationMessage For="() => Input.DisplayName" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="@Localizer["Register_EmailPlaceholder"]" />
                <label for="Input.Email">@Localizer["Register_EmailLabel"]</label>
                <ValidationMessage For="() => Input.Email" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputSelect @bind-Value="Input.RequestedRole" id="Input.RequestedRole" class="form-select" aria-required="true">
                    @foreach (string roleName in SelectableRoleNames)
                    {
                        <option value="@roleName">
                            @DescribeRole(roleName)
                        </option>
                    }
                </InputSelect>
                <label for="Input.RequestedRole">@Localizer["Register_RequestedRoleLabel"]</label>
                <ValidationMessage For="() => Input.RequestedRole" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@Localizer["Register_PasswordPlaceholder"]" />
                <label for="Input.Password">@Localizer["Register_PasswordLabel"]</label>
                <ValidationMessage For="() => Input.Password" class="text-danger" />
            </div>
            <div class="form-floating mb-3">
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="@Localizer["Register_PasswordPlaceholder"]" />
                <label for="Input.ConfirmPassword">@Localizer["Register_ConfirmPasswordLabel"]</label>
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>
            <button type="submit" class="w-100 btn btn-lg btn-primary">@Localizer["Register_Submit"]</button>
        </EditForm>
    </div>
</div>

@code {
    /// <summary>
    /// The roles a registrant may request. All three are selectable; every
    /// registration is pending, so a clinical pathologist request only takes
    /// effect once an active pathologist activates the account.
    /// </summary>
    private static readonly string[] SelectableRoleNames =
    [
        ApplicationRoleNames.ClinicalPathologist,
        ApplicationRoleNames.OtherDoctor,
        ApplicationRoleNames.InfectiousDiseaseControlTeam,
    ];

    private IEnumerable<IdentityError>? identityErrors;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    private string? Message =>
        identityErrors is null
            ? null
            : Localizer["Status_ErrorPrefix"]
                + string.Join(", ", identityErrors.Select(error => error.Description));

    /// <summary>
    /// The localized label for a role token. The token itself stays as the
    /// option value because it is what the database stores, but what the reader
    /// sees is translated here at the point of display. The service layer keeps
    /// its own English mapping; this page is the user facing side.
    /// </summary>
    private string DescribeRole(string roleName)
    {
        string resourceKey = roleName switch
        {
            ApplicationRoleNames.ClinicalPathologist => "Role_ClinicalPathologist",
            ApplicationRoleNames.OtherDoctor => "Role_OtherDoctor",
            ApplicationRoleNames.InfectiousDiseaseControlTeam => "Role_InfectiousDiseaseControlTeam",
            _ => string.Empty,
        };

        if (resourceKey.Length == 0)
        {
            return ApplicationRoleDisplayNames.DisplayNameOf(roleName);
        }

        return Localizer[resourceKey];
    }

    protected override void OnInitialized()
    {
        Input ??= new();
    }

    public async Task RegisterUser(EditContext editContext)
    {
        ArgumentNullException.ThrowIfNull(editContext);

        ApplicationUser user = CreateUser();
        user.DisplayName = Input.DisplayName;
        user.RequestedRole = Input.RequestedRole;
        user.AccountStatus = AccountStatus.Pending;

        await UserStore.SetUserNameAsync(user, Input.Email, CancellationToken.None);

        IUserEmailStore<ApplicationUser> emailStore = GetEmailStore();
        await emailStore.SetEmailAsync(user, Input.Email, CancellationToken.None);

        IdentityResult creationResult = await UserManager.CreateAsync(user, Input.Password);

        if (!creationResult.Succeeded)
        {
            identityErrors = creationResult.Errors;
            return;
        }

        Logger.LogInformation(
            "A new pending account was created requesting the {RequestedRole} role.",
            Input.RequestedRole);

        // The account is pending, so signing in would only lead to AccessDenied.
        // Send the registrant to the login page with a clear status message instead.
        RedirectManager.RedirectToWithStatus(
            "Account/Login",
            Localizer["Register_CreatedAwaitingActivation"],
            HttpContext);
    }

    private static ApplicationUser CreateUser()
    {
        try
        {
            return Activator.CreateInstance<ApplicationUser>();
        }
        catch
        {
            throw new InvalidOperationException(
                $"Can't create an instance of '{nameof(ApplicationUser)}'. " +
                $"Ensure that '{nameof(ApplicationUser)}' is not an abstract class and has a parameterless constructor.");
        }
    }

    private IUserEmailStore<ApplicationUser> GetEmailStore()
    {
        if (!UserManager.SupportsUserEmail)
        {
            throw new NotSupportedException(
                "The default UI requires a user store with email support.");
        }

        return (IUserEmailStore<ApplicationUser>)UserStore;
    }

    private sealed class InputModel
    {
        [Required]
        [StringLength(200)]
        public string DisplayName { get; set; } = "";

        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        public string RequestedRole { get; set; } = ApplicationRoleNames.OtherDoctor;

        [Required]
        [StringLength(100, MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("Password")]
        public string ConfirmPassword { get; set; } = "";
    }
}
