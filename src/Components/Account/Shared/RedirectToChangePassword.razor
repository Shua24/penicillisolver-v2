@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using penicillisolver_v2.Services

@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider

@* The interactive half of the must-change gate. The middleware covers a plain
   HTTP request; this covers a circuit that is already open, which would
   otherwise keep rendering the page it was opened on. Mounted in MainLayout so
   every page gets it. *@

@code {
    /// <summary>The path this component must not redirect away from.</summary>
    private const string ChangePasswordPath = "Account/ChangePassword";

    /// <inheritdoc />
    protected override async Task OnInitializedAsync()
    {
        AuthenticationState authenticationState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        ClaimsPrincipal user = authenticationState.User;

        Claim? mustChangeClaim = user.FindFirst(ApplicationClaimTypes.MustChangePassword);

        bool mustChange = mustChangeClaim is not null
            && string.Equals(mustChangeClaim.Value, "true", StringComparison.Ordinal);

        if (!mustChange)
        {
            return;
        }

        string currentPath = new Uri(NavigationManager.Uri).AbsolutePath;

        bool isOnChangePage = currentPath.EndsWith(
            ChangePasswordPath,
            StringComparison.OrdinalIgnoreCase);

        if (isOnChangePage)
        {
            return;
        }

        NavigationManager.NavigateTo(ChangePasswordPath, forceLoad: true);
    }
}
