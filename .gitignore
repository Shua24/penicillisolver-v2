src/App_Data/

# User secrets are stored outside the repo, but guard against a stray copy.
secrets.json
*.secrets.json

# OS noise
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*~

# Editor backups and swap files
*.swp
*.swo
*.tmp
*.bak

# Hermes agent working files: plans and notes are local workflow state.
.hermes/

# Local environment overrides. Never commit real values here.
.env
.env.*
!.env.example
